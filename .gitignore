__pycache__/
*.pyc
.venv/
venv/
data/
data_desktop/

# The user's PERSONAL music library is large binaries, never committed -
# same reasoning as the sibling apps' data/sde.sqlite. Commercials are
# the opposite: real app content shipped to every install (once real ad
# audio exists), so music_library_commercials/ is deliberately NOT
# excluded here - see CLAUDE.md's "Stations, commercials, and static"
# section.
music_library/*
!music_library/.gitkeep
!music_library/README.md
